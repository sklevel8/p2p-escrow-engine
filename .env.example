# HTTP
PORT=3000
NODE_ENV=development

# PostgreSQL (escrow ledger + audit log)
DATABASE_URL=postgres://escrow_user:change_me@localhost:5432/escrow

# Redis (webhook idempotency gate)
REDIS_URL=redis://localhost:6379

# PayFast ITN signature passphrase.
# The service refuses to process gateway callbacks when this is unset (fail-closed).
PAYFAST_PASSPHRASE=change_me_to_the_salt_passphrase_from_payfast_dashboard
