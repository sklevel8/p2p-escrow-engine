{
  "name": "p2p-escrow-engine",
  "version": "1.0.0",
  "private": true,
  "description": "South African peer-to-peer digital escrow engine with FICA/KYC and POPIA-aligned data handling",
  "license": "UNLICENSED",
  "main": "dist/src/app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/app.js",
    "dev": "tsx watch src/app.ts",
    "test": "npm run build && node --test dist/tests/EscrowStateMachine.test.js dist/tests/PayFastSignature.test.js dist/tests/GatewayEventPolicy.test.js",
    "migrate": "node -e \"const{readFileSync}=require('fs');const{Client}=require('pg');const c=new Client({connectionString:process.env.DATABASE_URL});c.connect().then(()=>c.query(readFileSync('src/db/schema.sql','utf8'))).then(()=>c.end()).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "knex": "^3.1.0",
    "pg": "^8.12.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
